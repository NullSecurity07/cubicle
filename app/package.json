{
  "name": "stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "shell:build": "pnpm build && cargo build --release --manifest-path shell/Cargo.toml",
    "shell": "shell/target/release/stage-shell",
    "shell:check": "STAGE_FAKE_MODEL=1 STAGE_API_PORT=7444 STAGE_WORKSPACE=$(mktemp -d) shell/target/release/stage-shell --perf",
    "shell:dev": "shell/target/release/stage-shell --url http://localhost:7420",
    "e2e": "playwright test",
    "assets": "node scripts/to-webp.mjs",
    "health": "node scripts/doctor.ts",
    "restore": "node scripts/restore.ts",
    "showcase": "node scripts/showcase.ts",
    "service:install": "node scripts/service.ts install",
    "service:status": "node scripts/service.ts status",
    "service:remove": "node scripts/service.ts remove",
    "check:providers": "node scripts/check-providers.ts",
    "check:media": "node scripts/check-media.ts",
    "check:evals": "node scripts/check-evals.ts",
    "vendor:hyperframes": "node scripts/vendor-hyperframes.ts",
    "site:shots": "node scripts/site-shots.ts",
    "site:film": "node scripts/site-film.ts",
    "frameworks:ledger": "node scripts/frameworks-ledger.ts",
    "gate": "tsc --noEmit && vitest run && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5",
    "@gradio/client": "2.7.0",
    "@huggingface/transformers": "^4.3.0",
    "@xyflow/react": "^12.11",
    "agent-browser": "^0.38.1",
    "autoevals": "0.0.132",
    "hyperframes": "0.8.55",
    "kokoro-js": "1.2.1",
    "mermaid": "^12.0.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.17.0",
    "pptxgenjs": "^4.0.1",
    "pyodide": "^314.0.7",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.63",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "~5.9",
    "vite": "^8.2",
    "vitest": "^4.1"
  }
}
