{
  "name": "@cubicle/app",
  "version": "0.1.0",
  "private": true,
  "description": "CUBICLE tray shell (Tauri): start/stop the daemon, open the office, open the vault, checkpoint on sleep",
  "scripts": {
    "build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "start": "src-tauri/target/release/cubicle-tray",
    "smoke": "src-tauri/target/release/cubicle-tray --smoke",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  }
}
