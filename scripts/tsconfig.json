{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["**/*.ts", "world/*.ts"],
  // Excluded for pre-existing type errors unrelated to the tower (map engine + roster) work this config was
  // added to cover: gen-docs.ts (no `zod` types resolved from the repo root; it is a core package dependency,
  // not a root one) and test-replay.ts (a `RoutedChatResult` used as a constructor, not this plan's concern).
  // Remove an entry once its script's own errors are fixed.
  "exclude": ["gen-docs.ts", "test-replay.ts"]
}
