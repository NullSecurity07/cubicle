{
  "name": "cubicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first self-running company on an Obsidian vault",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' run test",
    "typecheck": "pnpm -r --filter './packages/**' --filter '!@cubicle/app' exec tsc --noEmit -p . && tsc --noEmit -p scripts/tsconfig.json",
    "cubicle": "node --import tsx/esm --conditions=development packages/daemon/src/cli.ts",
    "launch": "bash scripts/run.sh",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:kill9": "node --import tsx/esm --conditions=development scripts/test-kill9.ts",
    "test:sleep": "node --import tsx/esm --conditions=development scripts/test-sleep.ts",
    "test:replay": "node --import tsx/esm --conditions=development scripts/test-replay.ts",
    "test:overlay": "node --import tsx/esm --conditions=development scripts/test-overlay-clicks.ts",
    "office:shot": "node --import tsx/esm --conditions=development scripts/office-shot.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23",
    "typescript": "~5.9",
    "vitest": "^4.1",
    "@cubicle/core": "workspace:*",
    "@cubicle/router": "workspace:*",
    "@cubicle/tools": "workspace:*",
    "@cubicle/harness": "workspace:*",
    "@cubicle/daemon": "workspace:*",
    "dbus-next": "^0.10",
    "yaml": "^2.9",
    "playwright": "^1.62"
  }
}
