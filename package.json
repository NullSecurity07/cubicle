{
  "name": "cubicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first self-running company on an Obsidian vault",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' run test",
    "cubicle": "tsx --conditions=development packages/daemon/src/cli.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:kill9": "tsx --conditions=development scripts/test-kill9.ts",
    "test:sleep": "tsx --conditions=development scripts/test-sleep.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23",
    "typescript": "~5.9",
    "vitest": "^4.1"
  }
}
